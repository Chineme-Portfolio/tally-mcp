# Port the MCP server listens on (defaults to 3001)
PORT=3001
# Postgres connection string (Railway Postgres in prod; a local container in dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/helm

# ---- Authentication (spec 0005) ----
# "none"  = single local user, no identity provider needed. For local development
#           and single user self hosting. REFUSED outside localhost, so it cannot
#           accidentally leave a deployed server open.
# unset   = authentication required (the safe default). Anything that is not
#           exactly "none" is treated as authenticated, so a typo fails closed.
AUTH_MODE=none

# Required when authentication is on. The Clerk instance that issues and signs
# access tokens; its JWKS is discovered from this, and every token's issuer must
# match it. This is your Clerk Frontend API URL.
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev

# Required when authentication is on. Tally's own canonical public URL: it is
# published as the protected resource identifier and checked against each
# token's audience. Must match the deployed URL exactly.
TALLY_RESOURCE_URL=http://localhost:3001

# The single user's id when AUTH_MODE=none (the seed writes a users row with
# this id). Ignored entirely when authentication is on, where accounts are
# created from verified tokens on first sign in.
DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001
